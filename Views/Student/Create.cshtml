@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<h1>Add Student</h1>

<form asp-action="Create" method="post">

    <!-- First Name -->
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <!-- Last Name -->
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <!-- Email -->
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- Gender -->
    <div class="mb-3">
        <label class="form-label">Gender</label>

        <div>
            <input asp-for="Gender" type="radio" value="Male" />
            <label>Male</label>

            <input asp-for="Gender" type="radio" value="Female" class="ms-3" />
            <label>Female</label>

            <input asp-for="Gender" type="radio" value="Other" class="ms-3" />
            <label>Other</label>
        </div>

        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <!-- Country -->
    <div class="mb-3">
        <label asp-for="CountryId" class="form-label">
            Country
        </label>

        <select asp-for="CountryId"
                asp-items="ViewBag.Countries"
                class="form-select"
                id="country">

            <option value="">-- Select Country --</option>

        </select>

        <span asp-validation-for="CountryId"
              class="text-danger"></span>
    </div>

    <!-- State -->
    <div class="mb-3">
        <label asp-for="StateId" class="form-label">
            State
        </label>

        <select asp-for="StateId"
                class="form-select"
                id="state">

            <option value="">-- Select State --</option>

        </select>

        <span asp-validation-for="StateId"
              class="text-danger"></span>
    </div>

    <!-- City -->
    <div class="mb-3">
        <label asp-for="CityId" class="form-label">
            City
        </label>

        <select asp-for="CityId"
                class="form-select"
                id="city">

            <option value="">-- Select City --</option>

        </select>

        <span asp-validation-for="CityId"
              class="text-danger"></span>
    </div>

    <!-- Buttons -->
    <button type="submit" class="btn btn-success">
        Save Student
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Country → State
        $("#country").change(function () {

            var countryId = $(this).val();

            // Clear State
            $("#state").empty();

            $("#state").append(
                '<option value="">-- Select State --</option>'
            );

            // Clear City
            $("#city").empty();

            $("#city").append(
                '<option value="">-- Select City --</option>'
            );

            if (countryId) {

                $.getJSON(
                    '/Student/GetStates?countryId=' + countryId,
                    function (states) {

                        $.each(states, function (index, state) {

                            $("#state").append(
                                '<option value="' +
                                state.id +
                                '">' +
                                state.name +
                                '</option>'
                            );

                        });

                    }
                );
            }

        });


        // State → City
        $("#state").change(function () {

            var stateId = $(this).val();

            // Clear City
            $("#city").empty();

            $("#city").append(
                '<option value="">-- Select City --</option>'
            );

            if (stateId) {

                $.getJSON(
                    '/Student/GetCities?stateId=' + stateId,
                    function (cities) {

                        $.each(cities, function (index, city) {

                            $("#city").append(
                                '<option value="' +
                                city.id +
                                '">' +
                                city.name +
                                '</option>'
                            );

                        });

                    }
                );
            }

        });

    </script>
}